{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkellySpeak",
  "identifier": "com.freemocap.skellyspeak",
  "build": {
    "additionalWatchFolders": [".."],
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SkellySpeak",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": [
        "AVFoundation",
        "AudioToolbox"
      ]
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/freemocap/skellyspeak/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNUUyNUQ4QzNGRkY1QjUKUldTMTlmL0QyQ1ZlY0dWMkVMYmxYOHZzOEV4ZnpEZ0ZkaG5MT2JoQS9qMjEzdTlwTi9Ic3N1NUUK"
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "skellyspeak"
          ],
          "host": "auth"
        }
      ]
    }
  }
}
